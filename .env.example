# Copie para .env e preencha. O .env real e gitignored.

# URL RAIZ do projeto Supabase, sem /rest/v1/
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave anon/publishable (Settings -> API). Publica por design.
VITE_SUPABASE_ANON_KEY=

# NUNCA use a service_role em variavel VITE_*: ela vai para o bundle do
# front e ignora a RLS, o que equivale a publicar o banco inteiro.

# Proxy de IA (opcional) - mantem a chave Gemini fora do navegador
VITE_AI_BASE_URL=
VITE_AI_PROXY_TOKEN=
VITE_AI_MODEL=gemini-2.0-flash

# Modelo de visao usado na correcao de redacao por FOTO quando o app fala
# direto com o Gemini (sem worker). Precisa ser multimodal.
VITE_AI_VISION_MODEL=gemini-1.5-flash

# =====================================================================
# SEGREDOS DO WORKER (server/worker.js)
#
# NAO entram neste arquivo nem em variavel VITE_*. Sao configurados no
# provedor do worker (wrangler secret put NOME / painel da Vercel), e
# estao listados aqui so como referencia do que precisa existir.
#
#   GEMINI_API_KEY        chat, quiz, redacao, roteiros de audio
#   API_TOKEN             protege a cota do worker (= VITE_AI_PROXY_TOKEN)
#   ALLOWED_ORIGIN        seu dominio, em vez de "*"
#
#   GOOGLE_TTS_KEY        Text-to-Speech das pilulas de audio.
#                         Sem ela o player cai na voz do sistema.
#
#   GEMINI_MODEL_CHAT     modelo do chat tematico (padrao gemini-1.5-flash).
#                         A familia importa: o nome da ferramenta de busca
#                         muda entre 1.5 (google_search_retrieval) e 2.x
#                         (google_search). O worker escolhe sozinho.
#   GEMINI_MODEL_VISION   modelo da correcao por foto (padrao gemini-1.5-flash)
#   GROUNDING_DESLIGADO   "1" desliga a busca do Google no chat. Util para
#                         cortar custo; as respostas passam a sair sem
#                         fonte, e a interface avisa.
#
#   SUPABASE_URL          mesmo valor de VITE_SUPABASE_URL
#   SUPABASE_SERVICE_KEY  service_role. So o worker tem. E o que permite
#                         confirmar pagamento e criar a sala de video.
#
#   MP_ACCESS_TOKEN       Mercado Pago. AUSENTE = MODO DEMONSTRACAO: a
#                         consulta e confirmada na hora, sem cobranca.
#                         Em producao, deixar vazio e dar consulta de
#                         graca - confira em GET /health.
#   MP_WEBHOOK_SECRET     valida o webhook de pagamento
#
#   RESEND_API_KEY        envio dos alertas por e-mail
#   EMAIL_REMETENTE       "Ampli-IA <avisos@seudominio.com>"
#
#   JITSI_BASE            padrao https://meet.jit.si
#   PUBLIC_APP_URL        usado nos links de retorno do checkout
# =====================================================================
